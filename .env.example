# Local development only. Public servers must use production mode.
P2K_ENV=development
P2K_HOST=127.0.0.1
P2K_PORT=8766
P2K_DATA_DIR=./data/p2k

# Production settings. Set these in the hosting environment, not in frontend files.
# P2K_ENV=production
# P2K_TOKEN_SECRET=generate-a-long-random-secret
# P2K_ALLOWED_ORIGINS=https://your-domain.example
# P2K_OMR_URL=http://127.0.0.1:8765
